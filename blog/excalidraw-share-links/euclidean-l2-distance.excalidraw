eline": 29, "autoResize": true, "lineHeight": 1.25}, {"id": "t17", "type": "text", "x": 60, "y": 645, "width": 1100, "height": 36, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a17", "roundness": {"type": 3}, "seed": 1541804687, "version": 1, "versionNonce": 1477278578, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 27, "fontFamily": 1, "text": "0 = identical. LOWER = more similar. Magnitude matters.", "originalText": "0 = identical. LOWER = more similar. Magnitude matters.", "textAlign": "left", "verticalAlign": "top", "baseline": 29, "autoResize": true, "lineHeight": 1.25}, {"id": "r18", "type": "rectangle", "x": 640, "y": 140, "width": 460, "height": 360, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a18", "roundness": {"type": 3}, "seed": 1136108455, "version": 1, "versionNonce": 186618212, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t19", "type": "text", "x": 670, "y": 160, "width": 420, "height": 337, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a19", "roundness": {"type": 3}, "seed": 1973214823, "version": 1, "versionNonce": 536124281, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 25, "fontFamily": 1, "text": "Step 1: subtract\na − b = [3−8, 4−6]\n= [−5, −2]\n\nStep 2: square and add\n(−5)² + (−2)²\n= 25 + 4 = 29\n\nStep 3: square root\n√29 ≈ 5.39", "originalText": "Step 1: subtract\na − b = [3−8, 4−6]\n= [−5, −2]\n\nStep 2: square and add\n(−5)² + (−2)²\n= 25 + 4 = 29\n\nStep 3: square root\n√29 ≈ 5.39", "textAlign": "left", "verticalAlign": "top", "baseline": 27, "autoResize": true, "lineHeight": 1.25}, {"id": "r20", "type": "rectangle", "x": 710, "y": 520, "width": 320, "height": 64, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffd6dd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a20", "roundness": {"type": 3}, "seed": 1625792788, "version": 1, "versionNonce": 338444265, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "t21", "type": "text", "x": 710, "y": 532, "width": 320, "height": 40, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a21", "roundness": {"type": 3}, "seed": 1259191106, "version": 1, "versionNonce": 1553210609, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 30, "fontFamily": 1, "text": "d(a, b) ≈ 5.39", "originalText": "d(a, b) ≈ 5.39", "textAlign": "center", "verticalAlign": "top", "baseline": 33, "autoResize": true, "lineHeight": 1.25}, {"id": "l22", "type": "line", "x": 60, "y": 720, "width": 1100, "height": 0, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": null, "index": "a22", "roundness": {"type": 3}, "seed": 825873197, "version": 1, "versionNonce": 298737107, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [1100, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "t23", "type": "text", "x": 60, "y": 745, "wid